{
  "name": "2eas-chart-studio-v5",
  "private": true,
  "version": "0.1.0",
  "description": "Opt-in, read-only Lightweight Charts v5 migration adapter",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/adapter.ts --bundle --format=iife --global-name=ChartStudioV5 --target=es2020 --outfile=dist/chart-studio-v5.js",
    "build:production": "esbuild src/adapter.ts --bundle --format=iife --global-name=ChartStudioV5 --target=es2020 --outfile=../static/chart-studio-v5.js"
  },
  "devDependencies": {
    "lightweight-charts": "5.2.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
