; ==============================================================================
; XAU Titan M5 - CHAMPION SCALP EDITION (0.5% Dynamisches Risiko)
; Dedizierte M5-Ausführung für XAUUSD Gold Scalping
; Blueberry Funded Prop-Firm konform (Harter Daily/Total Drawdown Circuit Breaker)
; ==============================================================================

; --- Risikomanagement & Positionsgröße ---
InpFixedLot=0.0
InpRiskPercent=0.5
InpMaxOpenPositions=3
InpMinBarsBetweenEntries=3
InpMagicNumber=881105
InpTradeComment=Titan_M5_Dyn05

; --- Struktureller Swing-SL & Runner-Ausstieg ---
InpUseSwingSL=true
InpSwingBarsLookback=48
InpMinSLPoints=1500
InpMaxSLPoints=15000
InpSLBufferPoints=250
InpUseDynamicExit=true
InpMinProfitUSDForExit=28.0
InpCloseInProfitAtSessionEnd=false
InpSessionEndMinProfitUSD=5.0
InpUseTakeProfit=false
InpTPRatio=0.0
InpUseBreakEven=false
InpBETriggerUSD=40.0
InpBELockUSD=15.0

; --- Handelszeiten & Filter (Serverzeit) ---
InpFilterEliteHours=true
InpEnableAsianSession=true
InpAvoidNewsSpikeHours=false
InpTradeStartHour=1
InpTradeStartMinute=0
InpTradeEndHour=23
InpTradeEndMinute=45

; --- Blueberry Funded Prop-Firm Schutz ---
InpEnablePropProtection=true
InpMaxDailyDrawdownPercent=3.5
InpMaxTotalDrawdownPercent=9.0
InpTotalDDBasedOnInitial=true
InpDailyLockoutUntilMidnight=true
InpManualDailyStartBalance=0.0
InpPhaseProfitTargetPct=0.0

; --- Trend-Momentum Indikatoren (M5 Basis) ---
InpCalcTimeframe=5
InpTrendEMAPeriod=50
InpFastEMAPeriod=9
InpSlowEMAPeriod=21
InpRSIPeriod=14
InpRSIMinMomentum=50.0

; --- Anti-Trap & Überdehnungs-Filter ---
InpUseOverextensionFilter=true
InpMaxATRExtension=1.8
InpUseConsecutiveRunFilter=true
InpMaxConsecutiveBars=3
InpUseSRDistanceFilter=true
InpMinSRRoomPoints=300
InpATRPeriod=14
