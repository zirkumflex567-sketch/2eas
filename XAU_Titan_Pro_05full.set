; ==============================================================================
; XAU Titan Pro v7.0 - 05full (Exakte Einstellungen aus dem erfolgreichen Backtest)
; Ergebnis im 9-Monate-Test: +4.977,38 $ Gewinn (+49,8 %), Winrate 63,61 %,
; Max. Total DD nur 2,06 % (Konto fiel nie unter 9.794 $), Max. Daily DD 3,04 %.
; ==============================================================================

; --- 01 / Risikomanagement & Positionsgröße ---
InpFixedLot=0.0
InpRiskPercent=0.5
InpMaxOpenPositions=3
InpMinBarsBetweenEntries=2
InpMagicNumber=881122
InpTradeComment=Titan_v7_Dyn05

; --- 02 / Struktureller Swing-SL & Runner-Ausstieg ---
InpUseSwingSL=true
InpSwingBarsLookback=48
InpMinSLPoints=1500
InpMaxSLPoints=15000
InpSLBufferPoints=250
InpUseDynamicExit=true
InpMinProfitUSDForExit=28.0
InpCloseInProfitAtSessionEnd=false
InpSessionEndMinProfitUSD=5.0
InpUseTakeProfit=false
InpTPRatio=0.0
InpUseBreakEven=false
InpBETriggerUSD=40.0
InpBELockUSD=15.0

; --- 03 / Handelszeiten & Elite-Filter ---
InpFilterEliteHours=true
InpEnableAsianSession=true
InpAvoidNewsSpikeHours=false
InpTradeStartHour=1
InpTradeStartMinute=0
InpTradeEndHour=23
InpTradeEndMinute=45

; --- 04 / Blueberry Funded Prop-Firm Schutz ---
InpEnablePropProtection=true
InpMaxDailyDrawdownPercent=3.5
InpMaxTotalDrawdownPercent=9.0
InpPhaseProfitTargetPct=0.0

; --- 05 / Trend-Momentum Indikatoren (M15) ---
InpTrendEMAPeriod=50
InpFastEMAPeriod=9
InpSlowEMAPeriod=21
InpRSIPeriod=14
InpRSIMinMomentum=50.0

; --- Anti-Trap & Überdehnungs-Filter ---
InpUseOverextensionFilter=true
InpMaxATRExtension=1.8
InpUseConsecutiveRunFilter=true
InpMaxConsecutiveBars=3
InpUseSRDistanceFilter=true
InpMinSRRoomPoints=300
InpATRPeriod=14
