; ==============================================================================
; XAU Titan Ultra v8.0 - LOW-LOSS CHAMPION EDITION (0.01 Lot Fest)
; Echte Trendfolge mit 3 neuen Verlustbegrenzungs-Hebeln:
; HEBEL 1: Trend-Invalidation Exit aktiv (Schließt Verlusttrades früh bei Trendbruch)
; HEBEL 2: Max SL auf 9.000 Punkte gedeckelt (Verhindert $150 Riesen-Verluste)
; HEBEL 3: Soft-Profit-Lock aktiv (Sichert Runner ab $45 Gewinn vor vollem -$80 Rückfall)
; US-News/Opening aktiv (InpAvoidNewsSpikeHours=false für volle Gewinne)
; Blueberry Funded Prop-Firm Schutz: 3.5% Daily / 9.0% Total Drawdown
; ==============================================================================

InpFixedLot=0.01
InpRiskPercent=0.0
InpMaxOpenPositions=3
InpMinBarsBetweenEntries=2
InpMagicNumber=881133
InpTradeComment=Titan_Ultra_001

InpUseSwingSL=true
InpSwingBarsLookback=48
InpMinSLPoints=1500
InpMaxSLPoints=9000
InpSLBufferPoints=250
InpUseDynamicExit=true
InpMinProfitUSDForExit=28.0
InpCloseInProfitAtSessionEnd=false
InpSessionEndMinProfitUSD=5.0
InpUseTakeProfit=false
InpTPRatio=0.0

; --- Hebel 1: Trend-Invalidation Exit ---
InpUseTrendInvalidationExit=true

; --- Hebel 3: Soft-Profit-Lock ---
InpUseSoftProfitLock=true
InpSoftLockTriggerUSD=45.0
InpSoftLockProtectUSD=5.0

; --- Break-Even ---
InpUseBreakEven=false
InpBETriggerUSD=40.0
InpBELockUSD=15.0

; --- Handelszeiten & Filter ---
InpFilterEliteHours=true
InpEnableAsianSession=true
InpAvoidNewsSpikeHours=false
InpTradeStartHour=1
InpTradeStartMinute=0
InpTradeEndHour=23
InpTradeEndMinute=45

; --- Blueberry Funded Prop-Firm Schutz ---
InpEnablePropProtection=true
InpMaxDailyDrawdownPercent=3.5
InpMaxTotalDrawdownPercent=9.0
InpTotalDDBasedOnInitial=true
InpDailyLockoutUntilMidnight=true
InpPhaseProfitTargetPct=0.0

; --- Indikatoren ---
InpTrendEMAPeriod=50
InpFastEMAPeriod=9
InpSlowEMAPeriod=21
InpRSIPeriod=14
InpRSIMinMomentum=50.0

; --- Anti-Trap & Überdehnungs-Filter ---
InpUseOverextensionFilter=true
InpMaxATRExtension=1.8
InpUseConsecutiveRunFilter=true
InpMaxConsecutiveBars=3
InpUseSRDistanceFilter=true
InpMinSRRoomPoints=300
InpATRPeriod=14
